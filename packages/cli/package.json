{
  "name": "@pagerender/cli",
  "version": "1.2.0",
  "description": "Command line client for the Pagerender API: render a URL, check what a crawler sees, purge and warm the cache",
  "keywords": [
    "pagerender",
    "prerender",
    "seo",
    "cli",
    "crawler",
    "rendering"
  ],
  "license": "MIT",
  "homepage": "https://pagerender.io/mcp-server",
  "bugs": {
    "url": "https://pagerender.io/contact"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "pagerender": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@pagerender/analyze": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nmbrthirteen/pagerender-tools.git",
    "directory": "packages/cli"
  }
}
